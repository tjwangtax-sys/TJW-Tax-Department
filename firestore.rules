rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isNumeric(v) {
      return v is int || v is float;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function isValidToken(token) {
      return token is string && token.size() >= 16 && token.size() <= 80 && token.matches('^[a-zA-Z0-9_-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser()
        && request.auth.token.email is string
        && request.auth.token.email.lower() in [
          'tjwang.tax@gmail.com',
          'tjw.tax@gmail.com'
        ];
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isStaff() {
      return isAdmin() || isDepartmentStaff() || (
        isVerifiedUser() && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
      );
    }

    function isDepartmentStaff() {
      return isVerifiedUser()
        && request.auth.token.email is string
        && (
          request.auth.token.email.lower().matches('.*@tjwang\\.com\\.my$')
          || request.auth.token.email.lower() in ['tjwang.tax@gmail.com', 'tjw.tax@gmail.com']
        );
    }

    function isValidFormType(ft) {
      return ft is string && ft in ['BE', 'B', 'M'];
    }

    function isValidYearOfAssessment(ya) {
      return ya is string && ya.matches('^20[2-9][0-9]$');
    }

    function isValidWorkflowStatus(st) {
      return st is string && st in [
        '1. Reminder Sent',
        '2. Follow-Up Pending',
        '3. Booked-In (Awaiting Docs)',
        '4. Docs Uploaded (Screening)',
        '5. Incomplete Docs (Follow-Up)',
        '6. Docs Complete',
        '7. Assigned to PIC',
        '8. In Progress',
        '9. Pending Review',
        '10. Review Queries',
        '11. Work Done & Fee Confirmed',
        '12. Draft & Invoice Sent',
        '13. Signed & Paid',
        '14. Submitted & Completed'
      ];
    }

    function isValidBookInMap(b) {
      return b is map
        && b.keys().hasAll(['reminderSentDate', 'followUpCount', 'followUpLogs', 'bookedInDate', 'isBookedIn'])
        && b.keys().hasOnly(['reminderSentDate', 'followUpCount', 'followUpLogs', 'bookedInDate', 'isBookedIn'])
        && b.reminderSentDate is string && b.reminderSentDate.size() <= 40
        && isNumeric(b.followUpCount) && b.followUpCount >= 0 && b.followUpCount <= 500
        && b.followUpLogs is list && b.followUpLogs.size() <= 50
        && (b.followUpLogs.size() == 0 || b.followUpLogs[0] is map)
        && b.bookedInDate is string && b.bookedInDate.size() <= 40
        && b.isBookedIn is bool;
    }

    function isValidDocumentsMap(d) {
      return d is map
        && d.keys().hasAll([
          'completenessStatus',
          'uploadedFiles',
          'bookInListing',
          'missingItems',
          'detectedReliefCategories',
          'screeningSummary',
          'lastScreenedAt'
        ])
        && d.keys().hasOnly([
          'completenessStatus',
          'uploadedFiles',
          'bookInListing',
          'missingItems',
          'detectedReliefCategories',
          'screeningSummary',
          'lastScreenedAt'
        ])
        && d.completenessStatus is string
        && d.completenessStatus in ['Not Uploaded', 'Screening Pending', 'Incomplete', 'Complete']
        && d.uploadedFiles is list && d.uploadedFiles.size() <= 50
        && (d.uploadedFiles.size() == 0 || d.uploadedFiles[0] is map)
        && d.bookInListing is list && d.bookInListing.size() <= 100
        && (d.bookInListing.size() == 0 || d.bookInListing[0] is map)
        && d.missingItems is list && d.missingItems.size() <= 40
        && (d.missingItems.size() == 0 || d.missingItems[0] is string)
        && d.detectedReliefCategories is list && d.detectedReliefCategories.size() <= 30
        && (d.detectedReliefCategories.size() == 0 || d.detectedReliefCategories[0] is string)
        && d.screeningSummary is string && d.screeningSummary.size() <= 4000
        && d.lastScreenedAt is string && d.lastScreenedAt.size() <= 40;
    }

    function isValidAssignmentMap(a) {
      return a is map
        && a.keys().hasAll([
          'picName',
          'reviewerName',
          'startedAt',
          'targetCompletionDate',
          'submittedForReviewAt',
          'reviewClearedAt',
          'reviewStatus',
          'reviewQueries'
        ])
        && a.keys().hasOnly([
          'picName',
          'reviewerName',
          'startedAt',
          'targetCompletionDate',
          'submittedForReviewAt',
          'reviewClearedAt',
          'reviewStatus',
          'reviewQueries'
        ])
        && a.picName is string && a.picName.size() <= 120
        && a.reviewerName is string && a.reviewerName.size() <= 120
        && a.startedAt is string && a.startedAt.size() <= 40
        && a.targetCompletionDate is string && a.targetCompletionDate.size() <= 40
        && a.submittedForReviewAt is string && a.submittedForReviewAt.size() <= 40
        && a.reviewClearedAt is string && a.reviewClearedAt.size() <= 40
        && a.reviewStatus is string
        && a.reviewStatus in ['Unassigned', 'In Preparation', 'Pending Review', 'Queries Raised', 'Cleared']
        && a.reviewQueries is list && a.reviewQueries.size() <= 50
        && (a.reviewQueries.size() == 0 || a.reviewQueries[0] is map);
    }

    function isValidBillingMap(bl) {
      return bl is map
        && bl.keys().hasAll([
          'workDoneNotes',
          'feeAmount',
          'disbursements',
          'sstAmount',
          'totalWithTax',
          'draftSentDate',
          'followUpCount',
          'followUpLogs',
          'isSignedBack',
          'signedBackDate',
          'signedCopyUrl',
          'signedCopyFileName',
          'isPaid',
          'paymentDate',
          'receiptRef'
        ])
        && bl.keys().hasOnly([
          'workDoneNotes',
          'feeAmount',
          'disbursements',
          'sstAmount',
          'totalWithTax',
          'draftSentDate',
          'followUpCount',
          'followUpLogs',
          'isSignedBack',
          'signedBackDate',
          'signedCopyUrl',
          'signedCopyFileName',
          'isPaid',
          'paymentDate',
          'receiptRef'
        ])
        && bl.workDoneNotes is string && bl.workDoneNotes.size() <= 4000
        && isNumeric(bl.feeAmount) && bl.feeAmount >= 0 && bl.feeAmount <= 10000000
        && isNumeric(bl.disbursements) && bl.disbursements >= 0 && bl.disbursements <= 10000000
        && isNumeric(bl.sstAmount) && bl.sstAmount >= 0 && bl.sstAmount <= 10000000
        && isNumeric(bl.totalWithTax) && bl.totalWithTax >= 0 && bl.totalWithTax <= 20000000
        && bl.draftSentDate is string && bl.draftSentDate.size() <= 40
        && isNumeric(bl.followUpCount) && bl.followUpCount >= 0 && bl.followUpCount <= 500
        && bl.followUpLogs is list && bl.followUpLogs.size() <= 50
        && (bl.followUpLogs.size() == 0 || bl.followUpLogs[0] is map)
        && bl.isSignedBack is bool
        && bl.signedBackDate is string && bl.signedBackDate.size() <= 40
        && bl.signedCopyUrl is string && bl.signedCopyUrl.size() <= 500
        && bl.signedCopyFileName is string && bl.signedCopyFileName.size() <= 200
        && bl.isPaid is bool
        && bl.paymentDate is string && bl.paymentDate.size() <= 40
        && bl.receiptRef is string && bl.receiptRef.size() <= 120;
    }

    function isValidSubmissionMap(s) {
      return s is map
        && s.keys().hasAll([
          'lhdnSubmissionDate',
          'acknowledgementNo',
          'taxPayableOrRefund',
          'taxPosition',
          'completedAt'
        ])
        && s.keys().hasOnly([
          'lhdnSubmissionDate',
          'acknowledgementNo',
          'taxPayableOrRefund',
          'taxPosition',
          'completedAt'
        ])
        && s.lhdnSubmissionDate is string && s.lhdnSubmissionDate.size() <= 40
        && s.acknowledgementNo is string && s.acknowledgementNo.size() <= 120
        && isNumeric(s.taxPayableOrRefund) && s.taxPayableOrRefund >= -100000000 && s.taxPayableOrRefund <= 100000000
        && s.taxPosition is string && s.taxPosition in ['Payable', 'Refundable', 'Nil']
        && s.completedAt is string && s.completedAt.size() <= 40;
    }

    // Master Validation Blueprint for TaxJob
    function isValidTaxJob(data, jobId) {
      return data.keys().hasAll([
        'id',
        'ownerUid',
        'fileRef',
        'clientName',
        'icOrPassport',
        'tinNumber',
        'email',
        'phone',
        'formType',
        'yearOfAssessment',
        'status',
        'portalToken',
        'bookIn',
        'documents',
        'assignment',
        'billing',
        'submission',
        'createdAt',
        'updatedAt'
      ])
      && data.keys().hasOnly([
        'id',
        'ownerUid',
        'fileRef',
        'clientName',
        'icOrPassport',
        'tinNumber',
        'email',
        'phone',
        'formType',
        'yearOfAssessment',
        'status',
        'portalToken',
        'bookIn',
        'documents',
        'assignment',
        'billing',
        'submission',
        'createdAt',
        'updatedAt'
      ])
      && isValidId(data.id) && data.id == jobId
      && isValidId(data.ownerUid)
      && data.fileRef is string && data.fileRef.size() >= 1 && data.fileRef.size() <= 40
      && data.clientName is string && data.clientName.size() >= 1 && data.clientName.size() <= 160
      && data.icOrPassport is string && data.icOrPassport.size() >= 0 && data.icOrPassport.size() <= 40
      && data.tinNumber is string && data.tinNumber.size() >= 0 && data.tinNumber.size() <= 40
      && data.email is string && data.email.size() <= 160
      && data.phone is string && data.phone.size() <= 40
      && isValidFormType(data.formType)
      && isValidYearOfAssessment(data.yearOfAssessment)
      && isValidWorkflowStatus(data.status)
      && isValidToken(data.portalToken)
      && isValidBookInMap(data.bookIn)
      && isValidDocumentsMap(data.documents)
      && isValidAssignmentMap(data.assignment)
      && isValidBillingMap(data.billing)
      && isValidSubmissionMap(data.submission)
      && (data.createdAt is timestamp || data.createdAt == request.time)
      && (data.updatedAt is timestamp || data.updatedAt == request.time);
    }

    function isValidAdminRecord(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'role', 'createdAt'])
        && isValidId(data.uid) && data.uid == userId
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.role is string && data.role == 'admin'
        && (data.createdAt is timestamp || data.createdAt == request.time);
    }

    function isValidStaffRecord(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'createdAt'])
        && isValidId(data.uid) && data.uid == userId
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.role is string && data.role in ['pic', 'reviewer', 'manager', 'admin']
        && (data.createdAt is timestamp || data.createdAt == request.time);
    }

    function isActiveStaff() {
      return isVerifiedUser() && (
        isBootstrappedAdmin()
        || exists(/databases/$(database)/documents/staffUsers/$(request.auth.uid))
        || exists(/databases/$(database)/documents/staffUsers/$(request.auth.token.email))
      );
    }

    // --- Collection: taxJobs ---
    match /taxJobs/{jobId} {
      allow get, list: if isVerifiedUser();
      allow create: if isActiveStaff() && isValidTaxJob(incoming(), jobId) && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isActiveStaff() && isValidTaxJob(incoming(), jobId);
      allow delete: if isAdmin() && isValidId(jobId);
    }

    // --- Collection: staffUsers ---
    match /staffUsers/{userId} {
      allow get, list: if request.auth != null;
      allow create, update, delete: if request.auth != null && (
        request.auth.token.email.lower() == 'tjwang.tax@gmail.com'
        || request.auth.token.email.lower() == 'tjw.tax@gmail.com'
        || isAdmin()
      );
    }

    // --- Collection: auditLogs ---
    match /auditLogs/{logId} {
      allow create: if isVerifiedUser();
      allow get, list: if isAdmin();
      allow update, delete: if false;
    }

    // --- Collection: admins ---
    match /admins/{userId} {
      allow get: if isVerifiedUser() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isBootstrappedAdmin();
      allow create: if isAdmin()
        && isValidId(userId)
        && isValidAdminRecord(incoming(), userId);
      allow update: if false;
      allow delete: if isAdmin() && isValidId(userId);
    }

    // --- Collection: staff ---
    match /staff/{userId} {
      allow get: if isVerifiedUser() && isValidId(userId) && (request.auth.uid == userId || isStaff());
      allow list: if isBootstrappedAdmin();
      allow create: if isAdmin()
        && isValidId(userId)
        && isValidStaffRecord(incoming(), userId);
      allow update: if isAdmin()
        && isValidId(userId)
        && isValidStaffRecord(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'role']);
      allow delete: if isAdmin() && isValidId(userId);
    }
  }
}
